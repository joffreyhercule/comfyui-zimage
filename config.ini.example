; Copie de référence de config.ini.
; Le vrai config.ini est écrit par install.py et n'est pas versionné : il décrit
; l'installation de cette machine-là.

[comfyui]
; Port de ComfyUI, démarré par run.py. 8288 et non 8188 : une instance
; personnelle de ComfyUI n'est ni touchée ni lancée.
port = 8288
; Vide, sauf pour un ComfyUI sur une AUTRE machine : cette URL fait alors foi, et
; le port ci-dessus en est déduit. Le port n'est ainsi déclaré qu'une fois.
url =
; Racine de l'installation ComfyUI (portable Windows ou clone git). Relatif au
; projet — donc le renommer ou le déplacer ne casse rien. Un chemin absolu est
; accepté, pour une installation ComfyUI située ailleurs.
portable_dir = comfyui
; Dossier de sortie de ComfyUI, pour le déplacement atomique vers media/.
output_dir = comfyui/ComfyUI/output
; true = run.py démarre et arrête ComfyUI lui-même.
managed = true
; Arguments supplémentaires passés à ComfyUI, séparés par des espaces.
; Sous 16 Go de VRAM, --reserve-vram 2 laisse de la place à Ollama.
; Sans accélérateur utilisable, install.py y pose --cpu --disable-cuda-malloc,
; plus --bf16-unet sous 24 Go de RAM. Une valeur déjà là n'est jamais écrasée.
extra_args =
; Délai maximal d'un job, en secondes (premier chargement à froid inclus).
; 3600 sur une installation qui génère sur le processeur : une image y prend des
; dizaines de minutes, et 900 couperait des jobs qui avancent normalement.
job_timeout = 900

[server]
; Port du studio. 8388 et non 8000 : sous Windows, 8000 tombe souvent dans une plage
; réservée par Hyper-V ou WSL, où toute liaison est refusée (WinError 10013), quand il
; n'est pas simplement pris par un autre serveur. L'installateur en change de lui-même
; si celui-ci est inutilisable, et run.py le dit avant de démarrer quoi que ce soit.
port = 8388
; Vide = http://127.0.0.1:<port>. À remplir derrière un proxy, ou pour une machine
; joignable d'ailleurs : c'est l'URL que le serveur MCP rend à son client.
public_base_url =

[ollama]
; false quand Ollama est absent : les prompts partent verbatim.
enabled = true
translate_model = translategemma
url = http://127.0.0.1:11434

[models]
; Variante choisie par install.py selon l'accélérateur détecté.
; CUDA : z_image_turbo_int8_convrot / qwen_3_4b_fp8_mixed
; MPS, CPU, ROCm : z_image_turbo_bf16 / qwen_3_4b
unet = z_image_turbo_bf16.safetensors
clip = qwen_3_4b.safetensors
vae = ae.safetensors

[image]
default_width = 1024
default_height = 1024
